EKONEX_ENVIRONMENT=development
EKONEX_LOG_LEVEL=INFO
EKONEX_API_HOST=0.0.0.0
EKONEX_API_PORT=8000
EKONEX_DATABASE_URL=postgresql+asyncpg://ekonex:local-development-only@postgres:5432/ekonex_voice
EKONEX_REDIS_URL=redis://redis:6379/0
# Register every regional URL shown by the Alexa developer console, comma-separated.
EKONEX_ALEXA_REDIRECT_URIS=https://pitangui.amazon.com/api/skill/link/REPLACE_WITH_VENDOR_ID
EKONEX_ALEXA_OAUTH_CLIENT_ID=replace-with-alexa-client-id
# Secret-manager value in production; never commit the real value.
EKONEX_ALEXA_OAUTH_CLIENT_SECRET=replace-with-secret
EKONEX_ALEXA_ACCESS_TOKEN_TTL_SECONDS=3600
POSTGRES_DB=ekonex_voice
POSTGRES_USER=ekonex
POSTGRES_PASSWORD=local-development-only
